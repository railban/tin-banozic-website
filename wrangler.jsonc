{
  "name": "tin-banozic",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "rules": [
    { "type": "Data", "globs": ["**/*.webp", "**/*.png", "**/*.jpg"] },
    { "type": "Text", "globs": ["**/*.html", "**/*.txt", "**/*.xml"], "fallthrough": false }
  ],
  "routes": [
    { "pattern": "tin-banozic.from.hr", "custom_domain": true },
    { "pattern": "www.tin-banozic.from.hr", "custom_domain": true }
  ]
}
